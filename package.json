{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm install --no-frozen-lockfile && npm run typecheck:libs && npm --workspace=@workspace/api-server run build",
    "start": "npm --workspace=@workspace/api-server run start",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5.0.8": "5.0.9",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "uuid": "11.1.1",
      "esbuild@0.18.20": "0.25.12",
      "esbuild@0.27.3": "0.28.2"
    }
  },
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
