{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm install --no-frozen-lockfile && npm run typecheck:libs && npm --workspace=@workspace/api-server run build",
    "start": "npm --workspace=@workspace/api-server run start",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5.0.8": "5.0.9",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "uuid": "11.1.1",
      "esbuild@0.18.20": "0.25.12",
      "esbuild@0.27.3": "0.28.2"
    }
  },
  "private": true,
  "engines": {
    "node": "20.x"
  },
 "dependencies": {
  "zod": "^3.23.8",
  "drizzle-orm": "^0.33.0",
  "drizzle-zod": "^0.5.1",
  "@tanstack/react-query": "^5.51.1",
  "axios": "^1.7.2"
},
"devDependencies": {
  "typescript": "^5.5.4",
  "drizzle-kit": "^0.24.0",
  "@types/node": "^22.5.0"
}
}
